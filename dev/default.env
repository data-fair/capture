# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 6100-6149 so that they rarely collide with other local services.
# the dev API (npm run dev, npm run dev:api)
DEV_API_PORT=6100
# the API the tests start in-process (npm test)
TEST_API_PORT=6101
