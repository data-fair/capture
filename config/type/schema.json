{
  "$id": "https://github.com/data-fair/events/api/config",
  "x-exports": [
    "types",
    "validate"
  ],
  "x-ajv": {
    "coerceTypes": "array"
  },
  "type": "object",
  "title": "Api config",
  "additionalProperties": false,
  "required": [
    "port",
    "secretKeys",
    "helmet",
    "observer",
    "puppeteerLaunchOptions",
    "concurrency",
    "inspectConcurrency",
    "queue",
    "defaultLang",
    "defaultTimezone",
    "screenshotTimeout",
    "wait",
    "pngFastEncodingPixels",
    "maxAnimationFrames"
  ],
  "properties": {
    "port": {
      "type": "number"
    },
    "publicUrl": {
      "type": "string"
    },
    "privateDirectoryUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "helmet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active"],
      "properties": {
        "active": {
          "type": "boolean"
        }
      }
    },
    "secretKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture"],
      "properties": {
        "capture": {
          "type": "string"
        },
        "inspect": {
          "type": "string"
        }
      }
    },
    "observer": {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "port": {
          "type": "number"
        }
      }
    },
    "puppeteerLaunchOptions": {
      "type": "object"
    },
    "concurrency": {
      "type": "integer"
    },
    "queue": {
      "type": "object",
      "description": "Captures waiting for a browser context",
      "additionalProperties": false,
      "required": ["maxWaiting", "maxWaitTime"],
      "properties": {
        "maxWaiting": {
          "type": "integer",
          "minimum": 0,
          "description": "beyond this number of waiting captures, new ones are answered by a 503"
        },
        "maxWaitTime": {
          "type": "number",
          "description": "milliseconds of waiting for a context before a 503"
        }
      }
    },
    "inspectConcurrency": {
      "type": "integer",
      "minimum": 1
    },
    "defaultLang": {
      "type": "string"
    },
    "defaultTimezone": {
      "type": "string"
    },
    "onlySameHost": {
      "type": "boolean"
    },
    "useHostHeader": {
      "type": "boolean"
    },
    "screenshotTimeout": {
      "type": "number"
    },
    "wait": {
      "type": "object",
      "description": "How long a page that does not call window.triggerCapture is waited for",
      "additionalProperties": false,
      "required": ["networkIdleTime", "quietTime", "maxSettleTime"],
      "properties": {
        "networkIdleTime": {
          "type": "number",
          "description": "milliseconds without any network request before the page is considered loaded"
        },
        "quietTime": {
          "type": "number",
          "description": "then, milliseconds without DOM mutation, animation frame, finite animation or font loading before the capture"
        },
        "maxSettleTime": {
          "type": "number",
          "description": "the longest wait for that quiet, after the network is idle"
        }
      }
    },
    "pngFastEncodingPixels": {
      "type": "number",
      "description": "above this number of pixels, and for full page captures, PNG screenshots are encoded for speed rather than size"
    },
    "maxAnimationFrames": {
      "type": "number"
    },
    "util": {},
    "get": {},
    "has": {}
  }
}
